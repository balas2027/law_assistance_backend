# Application Config
PROJECT_NAME="NyayaAI API"
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]

# Security
# Run: openssl rand -hex 32 to generate a secure secret key
SECRET_KEY="replace_this_with_a_secure_random_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=11520 # 8 days

# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nyayaai"

# AI Services
ANTHROPIC_API_KEY="your-anthropic-api-key-here"
GROQ_API_KEY="your-groq-api-key-here"
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="openai/gpt-oss-120b"
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
CHROMA_DB_PATH="combined_db"
CHROMA_COLLECTION_NAME="legal_assistant"
